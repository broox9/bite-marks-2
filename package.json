{
	"name": "bite-marks-2",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"scripts": {
		"dev": "vp dev --host",
		"dev:convex": "convex dev",
		"dev:all": "convex dev & vp dev --host",
		"build": "node scripts/sync-wrangler-build-env.mjs && vp build",
		"build:local": "export CF_P=1 && npm run build",
		"preview": "vp preview",
		"preview:manual": "pnpx wrangler preview",
		"preview:worker": "npm run build && wrangler dev .svelte-kit/cloudflare/_worker.js",
		"deploy": "npm run build && wrangler deploy",
		"secrets:convex": "node scripts/put-convex-worker-secrets.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vp test run",
		"test:watch": "vp test"
	},
	"devDependencies": {
		"@ai-sdk/svelte": "^4.0.86",
		"@sveltejs/adapter-auto": "^6.1.1",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/vite": "^4.1.18",
		"@types/google.maps": "^3.58.1",
		"convex-test": "^0.0.54",
		"happy-dom": "^21.0.4",
		"svelte": "^5.56.8",
		"svelte-check": "^4.3.5",
		"tailwindcss": "^4.1.18",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
		"vite-plus": "1.5.0",
		"wrangler": "^4.160.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@better-auth/infra": "^0.3.7",
		"@convex-dev/better-auth": "^0.12.5",
		"@lucide/svelte": "^0.562.0",
		"@mmailaender/convex-better-auth-svelte": "^0.8.2",
		"@openai/agents": "^0.4.10",
		"@sentry/sveltekit": "^10.38.0",
		"@sveltejs/adapter-cloudflare": "^7.2.6",
		"ai": "^6.0.86",
		"appwrite": "^21.5.0",
		"better-auth": "~1.6.15",
		"convex": "^1.42.3",
		"convex-svelte": "^0.14.0",
		"mapbox-gl": "^3.19.0",
		"node-appwrite": "^21.1.0",
		"zod": "^4.3.6"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
	}
}
