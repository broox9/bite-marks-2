  "cards": [
    {
      "dot": "emerald",
      "title": "Component-local state",
      "items": [
        "/list: showSearch, listExpanded, filterValue, selectedResultObj are $state",
        "spotRows, savedPlaceIds, counts, filteredSpotRows are $derived from getSpots",
        "Mapbox markers rebuild in an $effect on filteredSpotRows + activeMapSpotId",
        "/spot/[id]: form fields seeded from getSpotById by $effect; saved via updateSpot"
      ]
    },
    {
      "dot": "violet",
      "title": "Shared stores",
      "items": [
        "locationStore: module-level $state (center, name, radiusMiles) + $derived radiusMeters; resets on reload",
        "Written by /settings and LocationTools on /; read by autocomplete bias, /list map pill, /spot distance",
        "Theme: localStorage key bite-marks-theme → <html data-theme>; map pages swap Mapbox style via MutationObserver"
      ]
    },
    {
      "dot": "cyan",
      "title": "Server state & refresh",
      "items": [
        "Remote query/command handlers read locals.user and throw 401 when absent",
        "After saveSpot, updateSpot, or deleteUserSpot, pages call invalidateAll() to refetch queries",
        "USE_CONVEX=1 selects ConvexAdapter; otherwise the legacy Appwrite adapter"
      ]
    },
    {
      "dot": "rose",
      "title": "Auth",
      "items": [
        "hooks.server resolves locals.user from the Better Auth cookie via Convex getCurrentUser",
        "+layout.server redirects signed-out users to /login, except /all-spots and /api/auth",
        "+layout.svelte seeds createSvelteAuthClient with server authState; /login uses authClient.signIn"
      ]
    }
  ]
