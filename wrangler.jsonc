{
  // Cloudflare Workers (Static Assets) — deploy with: npx wrangler deploy
  "name": "bite-marks-2",
  "compatibility_date": "2026-01-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // Non-secret public defaults only. Convex / feature flags are set via:
  //   npx wrangler secret put <NAME>
  // Build-time PUBLIC_* for $env/static/public live in gitignored .env.production.local
  // Local `wrangler dev` reads gitignored .dev.vars
  // Set APPWRITE_API_KEY (and other secrets) via: wrangler secret put APPWRITE_API_KEY
  "vars": {
    "NODE_ENV": "production",
    "PUBLIC_APP_URL": "https://bite.broox.us",
    "PUBLIC_CONVEX_URL": "https://fastidious-setter-628.convex.cloud",
    "PUBLIC_CONVEX_SITE_URL": "https://fastidious-setter-628.convex.site",
    "USE_CONVEX": "1"
  }
}
