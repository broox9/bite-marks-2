{
  // Cloudflare Workers (Static Assets) — deploy with: npx wrangler deploy
  "name": "bite-marks-2",
  "compatibility_date": "2026-01-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // SvelteKit $env/dynamic reads from platform.env at runtime. Convex URLs are public
  // deployment identifiers and are also required as build-time variables in Cloudflare Pages.
  "vars": {
    "NODE_ENV": "production",
    "PUBLIC_APP_URL": "https://bite.broox.us",
    "PUBLIC_CONVEX_URL": "https://fastidious-setter-628.convex.cloud",
    "PUBLIC_CONVEX_SITE_URL": "https://fastidious-setter-628.convex.site",
    "USE_CONVEX": "1"
  }
}
