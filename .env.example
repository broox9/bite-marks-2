# Appwrite Configuration (legacy — kept until cutover)
# See scripts/google-oauth-setup-checklist.md for setup instructions

# Public variables (exposed to client)
PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# Optional: Canonical URL for OAuth redirects (production only, if behind reverse proxy)
# REQUIRED in production to ensure OAuth redirect URLs are properly validated by Appwrite
# Example: PUBLIC_APP_URL=https://bite.broox.us
# PUBLIC_APP_URL=https://yourdomain.com

# Private variables (server-side only, NEVER expose to client)
APPWRITE_PROJECT_ID=your-project-id-here
APPWRITE_API_KEY=your-api-key-here

# Convex (written by `npx convex dev` into .env.local; also set on the Convex deployment)
# PUBLIC_CONVEX_URL=https://fastidious-setter-628.convex.cloud
# PUBLIC_CONVEX_SITE_URL=https://fastidious-setter-628.convex.site
# PUBLIC_SITE_URL=http://localhost:5173
# USE_CONVEX=0

# Google Maps API (if used)
# PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Sentry (error tracking)
# SENTRY_DSN=your-sentry-dsn-here
